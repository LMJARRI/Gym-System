# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca con prefijo NEXT_PUBLIC_ ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: si no se define se usa NEXT_PUBLIC_SUPABASE_URL
SUPABASE_URL=
# Conexión directa a Postgres, solo para migraciones y pruebas e2e
POSTGRES_URL_NON_POOLING=
# Secreto del cron de avisos de vencimiento (Vercel lo envía como Bearer). Generá uno largo y aleatorio.
CRON_SECRET=

# Mercado Pago (opcional: si falta, el botón de pago online no aparece y solo queda la transferencia)
# Access Token de la cuenta del gimnasio (Tus integraciones → Credenciales). Solo servidor.
MP_ACCESS_TOKEN=
# Clave secreta de webhooks (Tus integraciones → Webhooks). Recomendada: valida la firma de cada notificación.
MP_WEBHOOK_SECRET=
# URL pública del sitio, p. ej. https://tu-gimnasio.vercel.app (necesaria para el webhook y el regreso desde Mercado Pago)
NEXT_PUBLIC_SITE_URL=
